{
  "name": "@waelio/agent",
  "version": "0.2.2",
  "private": false,
  "description": "A high-performance, Cloudflare-ready Progressive Web App (PWA) frontend designed to interface seamlessly with local FastAPI and Ollama backends for an AI-powered researcher agent.",
  "author": "Wael Wahbeh <wahbehw@gmail.com> (https://waelio.com)",
  "contributors": [
    "Wael Wahbeh <wahbehw@me.com> (https://waelio.com)"
  ],
  "keywords": [
    "fastapi",
    "agent",
    "cloudflare",
    "cloudflare-pages",
    "ollama",
    "local-ai",
    "pwa",
    "research",
    "typescript",
    "vite"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://waelio-agent.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waelio/agent.git"
  },
  "bugs": {
    "url": "https://github.com/waelio/agent/issues"
  },
  "files": [
    ".env.example",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "index.html",
    "public",
    "src",
    "tsconfig.json",
    "vite.config.ts",
    "wrangler.jsonc"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
